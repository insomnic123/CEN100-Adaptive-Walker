  (title_block (title "Rollator test rig: rig controller (Arduino Uno R3)") (date "2026-11-21") (rev "1") (comment 1 "Servos only: continuous servos turn the wheels, standard servos move the IMU deck.") (comment 2 "Servo power (+5V_MOT) comes from the breadboard power module, never from the Uno.") (comment 3 "Only GND is shared between the Uno and the servo supply. No sensors on the Uno.") (comment 4 "Firmware: firmware/rig_uno/rig_uno.ino"))
